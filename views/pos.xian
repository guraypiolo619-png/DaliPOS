{{> head }}
<body class="min-h-screen bg-slate-50 text-slate-800">
  {{> nav }}
  <main id="pos-app" data-tax-rate="{{taxRatePercent}}" class="mx-auto max-w-[1600px] px-4 py-5 sm:px-6 lg:px-8">
    {{> alerts }}
    <div class="mb-5 flex flex-wrap items-center justify-between gap-3">
      <div class="flex items-center gap-3">
        <span class="h-7 w-1.5 rounded-full bg-pink-600"></span>
        <h1 class="text-xl font-black tracking-tight text-slate-900 sm:text-2xl">POS / Cashier</h1>
        <span class="hidden rounded-full bg-pink-50 px-3 py-1 text-xs font-bold text-pink-700 sm:inline-flex">Sales counter</span>
      </div>
      <div class="flex items-center gap-2 rounded-full border border-slate-200 bg-white px-3 py-1.5 text-xs font-semibold text-slate-600 shadow-sm sm:text-sm">
        <span class="grid h-7 w-7 place-items-center rounded-full bg-pink-100 text-pink-700"><svg aria-hidden="true" viewBox="0 0 20 20" fill="none" class="h-4 w-4"><circle cx="10" cy="6.5" r="3" stroke="currentColor" stroke-width="1.7"/><path d="M4 17a6 6 0 0 1 12 0" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg></span>
        <span>Cashier: <strong class="text-slate-800">{{user.name}}</strong></span>
      </div>
    </div>

    <div id="pos-message" role="status" aria-live="polite" class="mb-4 hidden rounded-xl border px-4 py-3 text-sm"></div>
    <div class="grid items-start gap-4 md:grid-cols-[minmax(0,1.15fr)_minmax(270px,.85fr)]">
      <section class="min-w-0 rounded-2xl border border-slate-200 bg-white p-3 shadow-sm sm:p-4">
        <div class="flex gap-2">
          <label for="product-search" class="relative min-w-0 flex-1">
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" class="pointer-events-none absolute left-3.5 top-1/2 h-5 w-5 -translate-y-1/2 text-slate-400"><circle cx="10.8" cy="10.8" r="6.8" stroke="currentColor" stroke-width="1.8"/><path d="m16 16 4.5 4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
            <input id="product-search" type="search" autocomplete="off" placeholder="Search product or scan barcode..." class="w-full rounded-xl border border-slate-200 bg-slate-50 py-3 pl-11 pr-4 text-sm outline-none transition placeholder:text-slate-400 focus:border-pink-500 focus:bg-white focus:ring-4 focus:ring-pink-100">
          </label>
          <button id="focus-barcode" type="button" aria-label="Focus barcode search" title="Focus barcode search" class="grid h-11 w-12 shrink-0 place-items-center rounded-xl border border-slate-200 bg-white text-slate-600 transition hover:border-pink-300 hover:bg-pink-50 hover:text-pink-700">
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" class="h-6 w-6"><path d="M4 5v14M7 5v14m3-14v14m5-14v14m2-14v14m3-14v14" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/><path d="M2 8h2m16 8h2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
          </button>
        </div>

        <div id="category-filters" aria-label="Filter products by category" class="mt-4 flex gap-2 overflow-x-auto pb-1">
          <button type="button" data-category-filter="all" aria-pressed="true" class="shrink-0 rounded-lg border border-slate-200 px-4 py-2 text-xs font-bold text-slate-600 transition">All</button>
          {{#each categories}}
          <button type="button" data-category-filter="{{this}}" aria-pressed="false" class="shrink-0 rounded-lg border border-slate-200 bg-white px-4 py-2 text-xs font-bold text-slate-600 transition">{{this}}</button>
          {{/each}}
        </div>
        <style>
          #category-filters [aria-pressed="true"] { border-color: var(--dali-pink); background: var(--dali-pink); color: white; }
        </style>

        <div id="product-list" class="mt-4 grid max-h-[58vh] grid-cols-2 gap-2.5 overflow-y-auto pr-1 sm:gap-3 lg:grid-cols-3 2xl:grid-cols-4">
          {{#each products}}
          <article class="product-card min-w-0 rounded-xl border border-slate-100 bg-slate-50/70 p-2 transition hover:border-pink-200 hover:bg-white hover:shadow-md" data-product-id="{{id}}" data-name="{{name}}" data-barcode="{{barcode}}" data-price="{{price}}" data-stock="{{stock}}" data-category="{{category.name}}">
            <button type="button" data-add class="group w-full text-center">
              <span class="mx-auto flex h-16 w-16 items-center justify-center overflow-hidden rounded-xl border border-slate-100 bg-white sm:h-20 sm:w-20">
                {{#if imageUrl}}
                <img src="{{imageUrl}}" alt="{{name}}" class="h-full w-full object-contain p-1" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                <span class="hidden h-full w-full items-center justify-center bg-pink-50 text-pink-400"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" class="h-8 w-8"><path d="m12 3 9 5-9 5-9-5 9-5Zm-9 9 9 5 9-5m-18 5 9 5 9-5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
                {{else}}
                <span class="flex h-full w-full items-center justify-center bg-pink-50 text-pink-400"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" class="h-8 w-8"><path d="m12 3 9 5-9 5-9-5 9-5Zm-9 9 9 5 9-5m-18 5 9 5 9-5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
                {{/if}}
              </span>
              <span class="mt-2 block truncate text-xs font-bold text-slate-800 sm:text-sm">{{name}}</span>
              <span class="mt-0.5 block text-xs font-black text-slate-900">₱{{price}}</span>
            </button>
            <div class="mt-1 flex items-center justify-between gap-1">
              <span class="truncate text-[10px] text-slate-500">{{category.name}}</span>
              <span class="shrink-0 rounded-full bg-white px-1.5 py-0.5 text-[10px] font-semibold text-slate-500">Stock {{stock}}</span>
            </div>
          </article>
          {{else}}
          <div class="rounded-xl bg-slate-50 p-6 text-center text-sm text-slate-500 col-span-full">No products are in stock. Update the inventory first.</div>
          {{/each}}
          <p id="no-products-found" class="hidden rounded-xl bg-slate-50 p-6 text-center text-sm text-slate-500 col-span-full">No products match your search.</p>
        </div>
        <p class="mt-3 hidden text-[11px] text-slate-400 xl:block">Tip: scan a barcode and press Enter · F2 focuses search</p>
      </section>

      <section class="min-w-0 rounded-2xl border border-slate-200 bg-white p-3 shadow-sm sm:p-4 md:sticky md:top-4">
        <div class="flex items-center justify-between border-b border-slate-100 pb-3">
          <div><h2 class="text-lg font-black text-slate-900">Current Sale</h2><p class="mt-0.5 text-xs text-slate-500"><span id="item-count">0</span> item(s)</p></div>
          <button id="clear-cart" type="button" class="rounded-lg px-3 py-2 text-xs font-bold text-slate-500 transition hover:bg-pink-50 hover:text-pink-700">Clear</button>
        </div>
        <div class="mt-3 grid grid-cols-[minmax(0,1fr)_54px_60px_66px_26px] gap-1 border-b border-slate-100 px-1 pb-2 text-[10px] font-bold text-slate-500 sm:text-xs">
          <span>Product</span><span class="text-center">Qty</span><span class="text-right">Price</span><span class="text-right">Total</span><span></span>
        </div>
        <div id="cart-items" aria-live="polite" class="max-h-[34vh] min-h-24 divide-y divide-slate-100 overflow-y-auto"></div>
        <div class="mt-3 space-y-2 border-t border-slate-100 pt-3 text-xs sm:text-sm">
          <div class="flex justify-between text-slate-500"><span>Subtotal</span><span>₱<span id="cart-subtotal">0.00</span></span></div>
          <div class="flex justify-between text-slate-500"><span>Tax ({{taxRatePercent}}%)</span><span>₱<span id="cart-tax">0.00</span></span></div>
          <div class="flex justify-between rounded-lg bg-pink-50 px-3 py-2 text-base font-black text-pink-700"><span>Total</span><span>₱<span id="cart-total">0.00</span></span></div>
        </div>
        <div class="mt-3 flex gap-2">
          <button id="checkout" type="button" class="flex flex-1 items-center justify-center gap-2 rounded-xl bg-pink-600 px-3 py-3 text-sm font-bold text-white shadow-sm transition hover:bg-pink-700 disabled:cursor-not-allowed disabled:bg-slate-300">
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" class="h-5 w-5"><path d="M3 4h2l2.2 10.1a2 2 0 0 0 2 1.6h8.5a2 2 0 0 0 1.9-1.4L22 8H6M10 20h.01M18 20h.01" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Checkout
          </button>
        </div>
        <section id="payment-panel" class="mt-4 hidden border-t border-slate-200 pt-4">
          <div class="mb-3"><h3 class="font-black text-slate-900">Payment details</h3><p class="mt-1 text-xs text-slate-500">Enter payment for the total, including tax.</p></div>
          <label class="mb-3 block text-xs font-semibold sm:text-sm">Customer name <span class="font-normal text-slate-400">(optional)</span>
            <input id="customer-name" type="text" maxlength="120" placeholder="Walk-in customer" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2">
          </label>
          <label class="mb-3 block text-xs font-semibold sm:text-sm">Payment method
            <select id="payment-method" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"><option value="cash">Cash</option><option value="gcash">GCash</option><option value="maya">Maya</option><option value="card">Card</option></select>
          </label>
          <div id="cash-fields">
            <label class="block text-xs font-semibold sm:text-sm">Cash received
              <span class="mt-1 flex items-center rounded-lg border border-slate-300 px-3"><span class="text-slate-500">₱</span><input id="amount-tendered" type="number" min="0" step="0.01" inputmode="decimal" placeholder="0.00" class="w-full border-0 px-2 py-2 outline-none"></span>
            </label>
            <div class="mt-2 flex justify-between text-sm"><span class="text-slate-500">Change due</span><strong>₱<span id="change-due">0.00</span></strong></div>
          </div>
          <p id="non-cash-note" class="hidden rounded-lg bg-slate-50 p-3 text-sm text-slate-600">Charge <strong>₱<span id="non-cash-total">0.00</span></strong> to the selected method.</p>
          <div class="mt-4 flex gap-2">
            <button id="back-to-order" type="button" class="w-1/3 rounded-xl border border-slate-300 px-3 py-3 text-sm font-bold text-slate-700 hover:bg-slate-50">Back</button>
            <button id="confirm-payment" type="button" class="w-2/3 rounded-xl bg-emerald-700 px-3 py-3 text-sm font-bold text-white hover:bg-emerald-800 disabled:cursor-not-allowed disabled:bg-slate-300">Confirm payment</button>
          </div>
        </section>
        <p class="mt-3 text-center text-[10px] leading-4 text-slate-400">Prices and stock are verified before the sale is saved.</p>
      </section>
    </div>
  </main>
  {{> footer }}
  <script>
    const taxRatePercent = Number(document.getElementById("pos-app").dataset.taxRate);
    const cart = new Map();
    const productCards = [...document.querySelectorAll(".product-card")];
    const categoryButtons = [...document.querySelectorAll("[data-category-filter]")];
    const searchInput = document.getElementById("product-search");
    const cartElement = document.getElementById("cart-items");
    const messageElement = document.getElementById("pos-message");
    const checkoutButton = document.getElementById("checkout");
    const paymentPanel = document.getElementById("payment-panel");
    const paymentMethodInput = document.getElementById("payment-method");
    const amountTenderedInput = document.getElementById("amount-tendered");
    const confirmPaymentButton = document.getElementById("confirm-payment");
    const activeCategory = { value: "all" };

    function showMessage(message, isError = false) {
      messageElement.textContent = message;
      messageElement.className = `mb-4 rounded-xl border px-4 py-3 text-sm ${isError ? "border-red-200 bg-red-50 text-red-800" : "border-emerald-200 bg-emerald-50 text-emerald-800"}`;
    }

    function filterProducts() {
      const query = searchInput.value.trim().toLowerCase();
      productCards.forEach((card) => {
        const matchesSearch = card.dataset.name.toLowerCase().includes(query) || card.dataset.barcode.toLowerCase().includes(query);
        const matchesCategory = activeCategory.value === "all" || card.dataset.category.toLowerCase() === activeCategory.value;
        card.hidden = !matchesSearch || !matchesCategory;
      });
      const hasVisibleProducts = productCards.some((card) => !card.hidden);
      document.getElementById("no-products-found").classList.toggle("hidden", hasVisibleProducts || productCards.length === 0);
    }

    function addProduct(card) {
      const id = card.dataset.productId;
      const stock = Number(card.dataset.stock);
      const line = cart.get(id) || {
        productId: Number(id),
        name: card.dataset.name,
        priceCents: Math.round(Number(card.dataset.price) * 100),
        quantity: 0,
        stock,
      };
      if (line.quantity >= stock) return showMessage(`Only ${stock} units of ${line.name} are in stock.`, true);
      line.quantity += 1;
      cart.set(id, line);
      renderCart();
    }

    function createQuantityButton(label, description, onClick) {
      const button = document.createElement("button");
      button.type = "button";
      button.className = "grid h-6 w-6 place-items-center rounded-md text-xs font-bold text-slate-600 hover:bg-pink-100 hover:text-pink-700";
      button.setAttribute("aria-label", description);
      button.textContent = label;
      button.addEventListener("click", onClick);
      return button;
    }

    function renderCart() {
      cartElement.replaceChildren();
      let subtotalCents = 0;
      let itemCount = 0;
      for (const [id, line] of cart) {
        const lineTotalCents = line.priceCents * line.quantity;
        subtotalCents += lineTotalCents;
        itemCount += line.quantity;

        const row = document.createElement("div");
        row.className = "grid grid-cols-[minmax(0,1fr)_54px_60px_66px_26px] items-center gap-1 px-1 py-3 text-[10px] sm:text-xs";
        const productName = document.createElement("span");
        productName.className = "truncate pr-1 font-semibold text-slate-800";
        productName.textContent = line.name;

        const quantity = document.createElement("span");
        quantity.className = "flex items-center justify-center rounded-lg bg-slate-50";
        quantity.append(
          createQuantityButton("−", `Remove one ${line.name}`, () => {
            line.quantity -= 1;
            if (line.quantity <= 0) cart.delete(id);
            renderCart();
          })
        );
        const quantityValue = document.createElement("span");
        quantityValue.className = "min-w-3 text-center font-bold text-slate-800";
        quantityValue.textContent = String(line.quantity);
        quantity.append(quantityValue, createQuantityButton("+", `Add one ${line.name}`, () => {
          if (line.quantity >= line.stock) return showMessage(`Only ${line.stock} units of ${line.name} are in stock.`, true);
          line.quantity += 1;
          renderCart();
        }));

        const price = document.createElement("span");
        price.className = "text-right text-slate-500";
        price.textContent = `₱${(line.priceCents / 100).toFixed(2)}`;
        const total = document.createElement("span");
        total.className = "text-right font-bold text-slate-800";
        total.textContent = `₱${(lineTotalCents / 100).toFixed(2)}`;
        const remove = document.createElement("button");
        remove.type = "button";
        remove.className = "grid h-7 w-7 place-items-center rounded-md text-pink-500 hover:bg-pink-50 hover:text-pink-700";
        remove.setAttribute("aria-label", `Remove ${line.name} from sale`);
        remove.innerHTML = '<svg aria-hidden="true" viewBox="0 0 20 20" fill="none" class="h-4 w-4"><path d="M4 6h12m-10 0 .7 11h6.6L14 6m-5 3v5m2-5v5M7 6l.5-2h5L13 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>';
        remove.addEventListener("click", () => { cart.delete(id); renderCart(); });
        row.append(productName, quantity, price, total, remove);
        cartElement.append(row);
      }

      const taxCents = Math.round(subtotalCents * taxRatePercent / 100);
      const totalCents = subtotalCents + taxCents;
      document.getElementById("cart-subtotal").textContent = (subtotalCents / 100).toFixed(2);
      document.getElementById("cart-tax").textContent = (taxCents / 100).toFixed(2);
      document.getElementById("cart-total").textContent = (totalCents / 100).toFixed(2);
      document.getElementById("item-count").textContent = String(itemCount);
      checkoutButton.disabled = itemCount === 0;
      confirmPaymentButton.disabled = itemCount === 0;
      document.getElementById("non-cash-total").textContent = (totalCents / 100).toFixed(2);
      updatePaymentSummary();
      if (itemCount === 0) {
        const empty = document.createElement("p");
        empty.className = "py-8 text-center text-xs text-slate-400";
        empty.textContent = "Your sale is empty. Select products to begin.";
        cartElement.append(empty);
      }
    }

    function updatePaymentSummary() {
      const isCash = paymentMethodInput.value === "cash";
      document.getElementById("cash-fields").hidden = !isCash;
      document.getElementById("non-cash-note").classList.toggle("hidden", isCash);
      const receivedCents = Math.round(Number(amountTenderedInput.value || 0) * 100);
      const subtotalCents = [...cart.values()].reduce((sum, line) => sum + line.priceCents * line.quantity, 0);
      const totalCents = subtotalCents + Math.round(subtotalCents * taxRatePercent / 100);
      document.getElementById("change-due").textContent = (Math.max(0, receivedCents - totalCents) / 100).toFixed(2);
      confirmPaymentButton.disabled = cart.size === 0 || (isCash && receivedCents < totalCents);
    }

    productCards.forEach((card) => card.querySelector("[data-add]").addEventListener("click", () => addProduct(card)));
    categoryButtons.forEach((button) => button.addEventListener("click", () => {
      activeCategory.value = button.dataset.categoryFilter.toLowerCase();
      categoryButtons.forEach((categoryButton) => categoryButton.setAttribute("aria-pressed", String(categoryButton === button)));
      filterProducts();
    }));
    searchInput.addEventListener("input", filterProducts);
    document.getElementById("focus-barcode").addEventListener("click", () => {
      searchInput.focus();
      searchInput.select();
    });
    searchInput.addEventListener("keydown", (event) => {
      if (event.key !== "Enter") return;
      event.preventDefault();
      const barcode = searchInput.value.trim().toLowerCase();
      const match = productCards.find((card) => card.dataset.barcode.toLowerCase() === barcode);
      if (match) {
        addProduct(match);
        searchInput.value = "";
        filterProducts();
      } else {
        showMessage("No in-stock product matches that barcode.", true);
      }
    });
    document.addEventListener("keydown", (event) => {
      if (event.altKey || event.ctrlKey || event.metaKey) return;
      if (event.key === "F2") {
        event.preventDefault();
        searchInput.focus();
        searchInput.select();
      } else if (event.key === "F4" && paymentPanel.classList.contains("hidden")) {
        event.preventDefault();
        checkoutButton.click();
      } else if (event.key === "Escape" && !paymentPanel.classList.contains("hidden")) {
        paymentPanel.classList.add("hidden");
        checkoutButton.classList.remove("hidden");
        checkoutButton.focus();
      }
    });
    document.getElementById("clear-cart").addEventListener("click", () => {
      cart.clear();
      paymentPanel.classList.add("hidden");
      checkoutButton.classList.remove("hidden");
      renderCart();
    });
    checkoutButton.addEventListener("click", () => {
      if (cart.size === 0) return;
      paymentPanel.classList.remove("hidden");
      checkoutButton.classList.add("hidden");
      updatePaymentSummary();
      if (paymentMethodInput.value === "cash") amountTenderedInput.focus();
    });
    document.getElementById("back-to-order").addEventListener("click", () => {
      paymentPanel.classList.add("hidden");
      checkoutButton.classList.remove("hidden");
    });
    paymentMethodInput.addEventListener("change", updatePaymentSummary);
    amountTenderedInput.addEventListener("input", updatePaymentSummary);
    confirmPaymentButton.addEventListener("click", async () => {
      confirmPaymentButton.disabled = true;
      try {
        const response = await fetch("/pos/checkout", {
          method: "POST",
          headers: { "Content-Type": "application/json", "Accept": "application/json" },
          body: JSON.stringify({
            items: [...cart.values()].map(({ productId, quantity }) => ({ productId, quantity })),
            customerName: document.getElementById("customer-name").value,
            paymentMethod: paymentMethodInput.value,
            amountTendered: amountTenderedInput.value,
          }),
        });
        const result = await response.json();
        if (!response.ok) throw new Error(result.error || "The sale could not be saved.");
        window.location.assign(result.receiptUrl);
      } catch (error) {
        showMessage(error.message, true);
        confirmPaymentButton.disabled = false;
      }
    });
    renderCart();
  </script>
</body>
</html>
