{{> head }}
<body class="min-h-screen bg-slate-50 text-slate-800">
  {{> nav }}
  <main class="mx-auto max-w-7xl px-4 py-8 sm:px-6">
    {{> alerts }}
    <div class="mb-7"><p class="text-sm font-bold uppercase tracking-wider text-pink-700">Admin · Inventory</p><h1 class="mt-1 text-3xl font-black text-slate-900">Products</h1><p class="mt-2 text-slate-500">Manage prices, barcodes, stock, and categories.</p></div>
    <div class="grid gap-6 lg:grid-cols-[minmax(0,2fr)_minmax(260px,1fr)]">
      <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
        <h2 class="mb-4 text-lg font-bold">Add a product</h2>
        <form action="/admin/products" method="post" enctype="multipart/form-data" class="grid gap-3 sm:grid-cols-2">
          <input name="name" required maxlength="150" placeholder="Product name" class="rounded-lg border border-slate-300 px-3 py-2">
          <input name="barcode" required maxlength="64" placeholder="Barcode / SKU" class="rounded-lg border border-slate-300 px-3 py-2">
          <label class="text-sm text-slate-600">Selling price (₱)<input name="price" type="number" min="0" step="0.01" required class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"></label>
          <label class="text-sm text-slate-600">Unit cost (₱)<input name="costPrice" type="number" min="0" step="0.01" value="0" required class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"></label>
          <label class="text-sm text-slate-600">Initial stock<input name="stock" type="number" min="0" step="1" required class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2"></label>
          <select name="categoryId" class="rounded-lg border border-slate-300 px-3 py-2"><option value="">No category</option>{{#each categories}}<option value="{{id}}">{{name}}</option>{{/each}}</select>
          <div class="text-sm text-slate-600">Product picture (optional)
            <label class="mt-1 flex w-full cursor-pointer items-center justify-between rounded-lg border border-slate-300 bg-slate-50 px-3 py-2 text-sm text-slate-600 transition hover:border-pink-300 hover:bg-pink-50 hover:text-pink-700">
              <span data-photo-label data-empty-label="Choose image">Choose image</span>
              <input name="image" type="file" accept="image/jpeg,image/png,image/webp" class="sr-only">
            </label>
          </div>
          <button class="rounded-lg bg-pink-700 px-4 py-2 font-bold text-white hover:bg-pink-800">Save product</button>
        </form>
      </section>
      <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
        <h2 class="mb-4 text-lg font-bold">New category</h2>
        <form action="/admin/categories" method="post" class="flex gap-2">
          <input name="name" maxlength="100" required placeholder="e.g. Drinks" class="min-w-0 flex-1 rounded-lg border border-slate-300 px-3 py-2">
          <button class="rounded-lg bg-slate-900 px-4 py-2 font-bold text-white hover:bg-slate-700">Add</button>
        </form>
        <p class="mt-3 text-sm text-slate-500">{{categories.length}} categories</p>
      </section>
    </div>
    <section class="mt-7 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
      <div class="flex flex-wrap items-end justify-between gap-3 border-b border-slate-100 px-5 py-4">
        <div><h2 class="font-bold">Inventory</h2><p class="text-sm text-slate-500">Removing a product deactivates it to preserve its sales history.</p></div>
        <div class="flex flex-wrap gap-2"><input data-product-search type="search" placeholder="Search inventory..." class="rounded-lg border border-slate-300 px-3 py-2 text-sm"><select data-product-filter class="rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm"><option value="">All products</option><option value="low">Low stock (≤ 10)</option><option value="out">Out of stock</option><option value="removed">Removed</option></select><button data-update-all type="button" class="rounded-lg bg-pink-700 px-3 py-2 text-sm font-bold text-white hover:bg-pink-800">Update all</button></div>
      </div>
      <div class="overflow-x-auto">
        <table id="inventory-table" class="w-full min-w-[1000px] text-left text-sm">
          <thead class="bg-slate-50 text-xs uppercase text-slate-500"><tr><th class="px-4 py-3">Product</th><th class="px-4 py-3">Picture</th><th class="px-4 py-3">Barcode</th><th class="px-4 py-3">Sell / cost</th><th class="px-4 py-3">Stock</th><th class="px-4 py-3">Category</th><th class="px-4 py-3">Status / actions</th></tr></thead>
          <tbody class="divide-y divide-slate-100">
          {{#each products}}
            <tr data-product-row data-search="{{name}} {{barcode}} {{category.name}} {{stock}}" data-active="{{isActive}}" data-stock="{{stock}}" class="{{#unless isActive}}bg-slate-50 opacity-60{{/unless}}">
              <td colspan="7" class="px-4 pt-4 font-semibold text-slate-800">{{name}}</td>
            </tr>
            <tr data-product-row data-search="{{name}} {{barcode}} {{category.name}} {{stock}}" data-active="{{isActive}}" data-stock="{{stock}}" class="{{#unless isActive}}bg-slate-50 opacity-60{{/unless}}">
              <td class="px-4 pb-4"><form id="product-{{id}}" data-active="{{isActive}}" action="/admin/products/{{id}}/update" method="post" enctype="multipart/form-data"></form><input form="product-{{id}}" name="name" value="{{name}}" required maxlength="150" class="w-40 rounded border border-slate-300 px-2 py-1"></td>
              <td class="px-4 pb-4">
                <div class="mb-2 overflow-hidden rounded-xl border border-slate-200 bg-slate-50 shadow-sm">
                  {{#if imageUrl}}
                    <img src="{{imageUrl}}" alt="{{name}}" class="h-16 w-16 object-cover shadow-inner" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                    <div class="hidden h-16 w-16 items-center justify-center bg-slate-100 text-[10px] font-semibold uppercase tracking-wide text-slate-400">No image</div>
                  {{else}}
                    <div class="flex h-16 w-16 items-center justify-center bg-slate-100 text-[10px] font-semibold uppercase tracking-wide text-slate-400">No image</div>
                  {{/if}}
                </div>
                {{#if isActive}}<label class="flex cursor-pointer items-center justify-center rounded-lg border border-dashed border-slate-300 bg-slate-50 px-2 py-1.5 text-[11px] font-medium text-slate-600 transition hover:border-pink-300 hover:bg-pink-50 hover:text-pink-700"><span data-photo-label data-empty-label="Choose file">Choose file</span><input form="product-{{id}}" name="image" type="file" accept="image/jpeg,image/png,image/webp" aria-label="Replace picture for {{name}}" class="sr-only"></label>{{/if}}
              </td>
              <td class="px-4 pb-4"><input form="product-{{id}}" name="barcode" value="{{barcode}}" required class="w-32 rounded border border-slate-300 px-2 py-1"></td>
              <td class="space-y-1 px-4 pb-4"><input form="product-{{id}}" name="price" type="number" min="0" step="0.01" aria-label="Selling price for {{name}}" value="{{price}}" required class="w-24 rounded border border-slate-300 px-2 py-1"><input form="product-{{id}}" name="costPrice" type="number" min="0" step="0.01" aria-label="Unit cost for {{name}}" value="{{costPrice}}" required class="w-24 rounded border border-slate-300 px-2 py-1"></td>
              <td class="space-y-1 px-4 pb-4"><input form="product-{{id}}" name="stock" type="number" min="0" step="1" aria-label="Stock quantity for {{name}}" value="{{stock}}" required class="w-20 rounded border border-slate-300 px-2 py-1">{{#if isLowStock}}<span class="block w-fit rounded-full bg-orange-100 px-2 py-1 text-[10px] font-bold text-orange-800">{{#if isOutOfStock}}Out of stock{{else}}Low stock{{/if}}</span>{{/if}}{{#if isActive}}<select form="product-{{id}}" name="stockReason" aria-label="Stock change reason for {{name}}" class="w-28 rounded border border-slate-300 px-2 py-1 text-xs"><option value="adjustment">Adjustment</option><option value="restock">Restock</option></select>{{/if}}</td>
              <td class="px-4 pb-4"><select form="product-{{id}}" name="categoryId" class="max-w-36 rounded border border-slate-300 px-2 py-1"><option value="">None</option>{{#each categoryOptions}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></td>
              <td class="px-4 pb-4">
                {{#if isActive}}<span class="mr-2 rounded-full bg-emerald-100 px-2 py-1 text-xs font-bold text-emerald-800">Active</span><button form="product-{{id}}" class="rounded bg-slate-900 px-3 py-1.5 font-semibold text-white">Update</button>{{else}}<span class="rounded-full bg-slate-200 px-2 py-1 text-xs font-bold text-slate-600">Removed</span>{{/if}}
                {{#if isActive}}<form action="/admin/products/{{id}}/deactivate" method="post" class="inline"><button class="ml-2 rounded border border-red-200 px-3 py-1.5 font-semibold text-red-700" onclick="return confirm('Remove this product from the POS?')">Remove</button></form>{{/if}}
              </td>
            </tr>
          {{else}}
            <tr><td colspan="7" class="px-5 py-10 text-center text-slate-500">No products yet. Add one using the form above.</td></tr>
          {{/each}}
          </tbody>
        </table>
      </div>
    </section>
  </main>
  {{> footer }}
  <script>
    const inventoryRows = Array.from(document.querySelectorAll("[data-product-row]"));
    const inventorySearch = document.querySelector("[data-product-search]");
    const inventoryFilter = document.querySelector("[data-product-filter]");
    const filterInventory = () => {
      const query = inventorySearch.value.trim().toLowerCase();
      inventoryRows.forEach((row) => {
        const stock = Number(row.dataset.stock);
        const active = row.dataset.active === "true";
        const searchMatches = row.dataset.search.toLowerCase().includes(query);
        const filterMatches = inventoryFilter.value === "low" ? active && stock <= 10
          : inventoryFilter.value === "out" ? active && stock === 0
          : inventoryFilter.value === "removed" ? !active : true;
        row.hidden = !(searchMatches && filterMatches);
      });
    };
    inventorySearch.addEventListener("input", filterInventory);
    inventoryFilter.addEventListener("change", filterInventory);

    const productForms = Array.from(document.querySelectorAll('form[id^="product-"][data-active="true"]'));
    const updateAllButton = document.querySelector("[data-update-all]");
    const savedScrollY = sessionStorage.getItem("productsScrollY");
    if (savedScrollY !== null) {
      sessionStorage.removeItem("productsScrollY");
      window.requestAnimationFrame(() => window.scrollTo(0, Number(savedScrollY)));
    }

    productForms.forEach((form) => {
      form.addEventListener("submit", () => {
        sessionStorage.setItem("productsScrollY", String(window.scrollY));
      });
    });

    updateAllButton.disabled = productForms.length === 0;
    updateAllButton.addEventListener("click", async () => {
      if (!productForms.length || !productForms.every((form) => form.reportValidity())) return;
      if (!window.confirm("Are you sure update all active products?")) return;

      const updates = [];
      const requestBody = new FormData();
      let imageCount = 0;
      productForms.forEach((form) => {
        const formData = new FormData(form);
        const id = Number(form.id.slice("product-".length));
        updates.push({
          id,
          name: formData.get("name"),
          barcode: formData.get("barcode"),
          price: formData.get("price"),
          costPrice: formData.get("costPrice"),
          stock: formData.get("stock"),
          categoryId: formData.get("categoryId"),
          stockReason: formData.get("stockReason"),
        });
        const image = formData.get("image");
        if (image instanceof File && image.size > 0) {
          requestBody.append(`image_${id}`, image);
          imageCount += 1;
        }
      });
      requestBody.append("updates", JSON.stringify(updates));
      if (imageCount > 20) {
        window.showDaliToast("Update at most 20 replacement pictures at a time.", true);
        return;
      }

      updateAllButton.disabled = true;
      updateAllButton.textContent = "Updating...";
      sessionStorage.setItem("productsScrollY", String(window.scrollY));
      try {
        const response = await fetch("/admin/products/update-all", {
          method: "POST",
          headers: { Accept: "application/json" },
          body: requestBody,
        });
        const result = await response.json().catch(() => null);
        if (!response.ok) throw new Error((result && result.message) || "Could not update products.");
        window.location.reload();
      } catch (error) {
        sessionStorage.removeItem("productsScrollY");
        window.showDaliToast(error.message || "Could not update products.", true);
      } finally {
        updateAllButton.disabled = false;
        updateAllButton.textContent = "Update all";
      }
    });

    document.querySelectorAll('input[type="file"]').forEach((input) => {
      input.addEventListener('change', () => {
        const file = input.files && input.files[0];
        const label = input.closest('label');
        const name = label && label.querySelector('[data-photo-label]');
        if (!label) return;

        if (!file) {
          if (name) name.textContent = name.dataset.emptyLabel;
          return;
        }

        if (name) name.textContent = file.name;
      });
    });
  </script>
