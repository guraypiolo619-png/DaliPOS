{{> head }}
<body class="min-h-screen bg-slate-50 text-slate-800">
  {{> nav }}
  <main class="mx-auto max-w-7xl px-4 py-8 sm:px-6">
    {{> alerts }}
    <div class="mb-7"><p class="text-sm font-bold uppercase tracking-wider text-pink-700">Admin · Access control</p><h1 class="mt-1 text-3xl font-black text-slate-900">User accounts</h1><p class="mt-2 text-slate-500">Create staff or admin accounts and manage access.</p></div>
    <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <h2 class="mb-4 text-lg font-bold">Create an account</h2>
      <form action="/admin/users" method="post" class="grid gap-3 sm:grid-cols-2 lg:grid-cols-5">
        <input name="name" required placeholder="Full name" class="rounded-lg border border-slate-300 px-3 py-2">
        <input name="email" type="email" required placeholder="Email" class="rounded-lg border border-slate-300 px-3 py-2">
        <input name="password" type="password" minlength="12" required placeholder="Password (12+ characters)" class="rounded-lg border border-slate-300 px-3 py-2">
        <select name="role" required class="rounded-lg border border-slate-300 px-3 py-2"><option value="staff">Staff</option><option value="admin">Admin</option></select>
        <button class="rounded-lg bg-pink-700 px-4 py-2 font-bold text-white hover:bg-pink-800">Create account</button>
      </form>
    </section>
    <section class="mt-7 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
      <div class="border-b border-slate-100 px-5 py-4"><h2 class="font-bold">Accounts</h2><p class="text-sm text-slate-500">Disabling an account preserves its sales history.</p></div>
      <div class="overflow-x-auto">
        <table class="w-full min-w-[850px] text-left text-sm">
          <thead class="bg-slate-50 text-xs uppercase text-slate-500"><tr><th class="px-4 py-3">Name / email</th><th class="px-4 py-3">Role</th><th class="px-4 py-3">New password (optional)</th><th class="px-4 py-3">Status / actions</th></tr></thead>
          <tbody class="divide-y divide-slate-100">
          {{#each users}}
            <tr>
              <td class="px-4 py-4"><form id="user-{{id}}" action="/admin/users/{{id}}/update" method="post"></form><input form="user-{{id}}" name="name" value="{{name}}" required class="mb-1 w-48 rounded border border-slate-300 px-2 py-1"><div class="text-xs text-slate-500">{{email}}</div></td>
              <td class="px-4 py-4"><select form="user-{{id}}" name="role" class="rounded border border-slate-300 px-2 py-1"><option value="staff" {{#unless roleIsAdmin}}selected{{/unless}}>Staff</option><option value="admin" {{#if roleIsAdmin}}selected{{/if}}>Admin</option></select></td>
              <td class="px-4 py-4"><input form="user-{{id}}" name="password" type="password" minlength="12" placeholder="At least 12 characters" class="w-56 rounded border border-slate-300 px-2 py-1"></td>
              <td class="px-4 py-4">
                {{#if isActive}}<span class="mr-2 text-emerald-700">Active</span>{{else}}<span class="mr-2 text-slate-500">Disabled</span>{{/if}}
                <button form="user-{{id}}" class="rounded bg-slate-900 px-3 py-1.5 font-semibold text-white">Save</button>
                  <form action="/admin/users/{{id}}/toggle" method="post" class="mt-2"><button class="rounded border border-slate-300 px-3 py-1.5 font-semibold">{{#if isActive}}Disable{{else}}Activate{{/if}}</button></form>
              </td>
            </tr>
          {{else}}
            <tr><td colspan="4" class="px-5 py-10 text-center text-slate-500">No user accounts found.</td></tr>
          {{/each}}
          </tbody>
        </table>
      </div>
    </section>
  </main>
  {{> footer }}
