{{> head }}
<body class="min-h-screen bg-slate-50 text-slate-800">
  {{> nav }}
  <main class="mx-auto max-w-7xl px-4 py-7 sm:px-6 lg:px-8">
    {{> alerts }}
    <div class="mb-6">
      <p class="text-xs font-bold uppercase tracking-[0.18em] text-pink-700">Inventory control</p>
      <h1 class="mt-1 text-3xl font-black tracking-tight text-slate-900">Stock history & alerts</h1>
      <p class="mt-2 text-slate-500">A complete record of restocks, sales deductions, and manual adjustments.</p>
    </div>

    <section class="mb-6 rounded-2xl border {{#if lowStock.length}}border-red-200 bg-red-50{{else}}border-emerald-200 bg-emerald-50{{/if}} p-5">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div>
          <h2 class="text-lg font-bold {{#if lowStock.length}}text-red-900{{else}}text-emerald-900{{/if}}">{{#if lowStock.length}}Low stock · {{lowStock.length}} alert{{else}}Stock levels look good{{/if}}</h2>
          <p class="mt-1 text-sm {{#if lowStock.length}}text-red-800{{else}}text-emerald-800{{/if}}">Warning threshold: 10 items or fewer. Depletion estimates use the last 30 days of sales.</p>
        </div>
        {{#if lowStock.length}}<a href="/admin/products" class="rounded-lg bg-red-700 px-4 py-2 text-sm font-bold text-white hover:bg-red-800">Restock inventory</a>{{/if}}
      </div>
      {{#if lowStock.length}}
      <div class="mt-4 grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
        {{#each lowStock}}
        <article class="rounded-xl border border-red-200 bg-white p-4">
          <div class="flex items-start justify-between gap-2"><h3 class="font-bold text-slate-900">{{name}}</h3><span class="rounded-full bg-red-100 px-2.5 py-1 text-xs font-bold text-red-800">Low Stock</span></div>
          <p class="mt-2 text-sm text-slate-600"><strong class="text-red-700">{{stock}}</strong> remaining</p>
          <p class="mt-1 text-xs text-slate-500">Estimated depletion: {{depletionEstimate}}</p>
        </article>
        {{/each}}
      </div>
      {{/if}}
    </section>

    <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
      <div class="flex flex-wrap items-end justify-between gap-4 border-b border-slate-100 px-5 py-4">
        <div><h2 class="font-bold text-slate-900">Stock movement log</h2><p class="text-sm text-slate-500">Most recent 250 movements · date and time shown in store locale</p></div>
        <form method="get" class="flex flex-wrap gap-2">
          <select name="movement" aria-label="Filter by movement type" class="rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm">
            <option value="">All movements</option>
            <option value="restock" {{#if filters.movement}}{{#ifEquals filters.movement "restock"}}selected{{/ifEquals}}{{/if}}>Restocks</option>
            <option value="sale" {{#ifEquals filters.movement "sale"}}selected{{/ifEquals}}>Sales</option>
            <option value="adjustment" {{#ifEquals filters.movement "adjustment"}}selected{{/ifEquals}}>Adjustments</option>
          </select>
          <button class="rounded-lg bg-slate-900 px-4 py-2 text-sm font-bold text-white">Filter</button>
          <input data-table-search="stock-table" type="search" placeholder="Search log..." class="w-40 rounded-lg border border-slate-300 px-3 py-2 text-sm sm:w-48">
        </form>
      </div>
      <div class="overflow-x-auto">
        <table id="stock-table" class="w-full min-w-[900px] text-left text-sm">
          <thead class="bg-slate-50 text-xs uppercase text-slate-500"><tr><th class="px-5 py-3">Product / movement</th><th class="px-5 py-3">Change</th><th class="px-5 py-3">Remaining stock</th><th class="px-5 py-3">Estimated depletion</th><th class="px-5 py-3">By</th><th class="px-5 py-3">Date & time</th></tr></thead>
          <tbody class="divide-y divide-slate-100">
            {{#each history}}
            <tr>
              <td class="px-5 py-4"><strong class="text-slate-900">{{productName}}</strong><span class="mt-1 block text-xs text-slate-500">{{movementLabel}}{{#if note}} · {{note}}{{/if}}</span></td>
              <td class="px-5 py-4"><span class="rounded-full px-2.5 py-1 font-bold {{#if isIncrease}}bg-emerald-100 text-emerald-800{{else}}bg-orange-100 text-orange-800{{/if}}">{{changeLabel}}</span></td>
              <td class="px-5 py-4 font-bold">{{stockBalance}}</td>
              <td class="px-5 py-4 text-slate-600">{{depletionEstimate}}</td>
              <td class="px-5 py-4 text-slate-600">{{actorName}}</td>
              <td class="whitespace-nowrap px-5 py-4 text-slate-500">{{createdAt}}</td>
            </tr>
            {{else}}
            <tr><td colspan="6" class="px-5 py-10 text-center text-slate-500">No stock movements have been recorded.</td></tr>
            {{/each}}
          </tbody>
        </table>
      </div>
    </section>
  </main>
  {{> footer }}
  <script>
    document.querySelectorAll("[data-table-search]").forEach((input) => {
      input.addEventListener("input", () => {
        const table = document.getElementById(input.dataset.tableSearch);
        const query = input.value.trim().toLowerCase();
        table.querySelectorAll("tbody tr").forEach((row) => {
          row.hidden = !row.textContent.toLowerCase().includes(query);
        });
      });
    });
  </script>
