{{> head }}
<body class="min-h-screen bg-slate-50 text-slate-800">
  {{> nav }}
  <main class="mx-auto max-w-xl px-4 py-20 text-center">
    <p class="text-sm font-bold uppercase tracking-widest text-pink-700">DALI POS</p>
    <h1 class="mt-3 text-3xl font-black text-slate-900">{{title}}</h1>
    <p class="mt-4 text-slate-600">{{message}}</p>
    <a href="/" class="mt-8 inline-block rounded-xl bg-pink-700 px-5 py-3 font-bold text-white hover:bg-pink-800">Back</a>
  </main>
  {{> footer }}
