<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#db2777">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            /* Keep legacy utility names while using DALI pink and gold. */
            pink: {
              50: "#fff1f5", 100: "#ffe4ec", 200: "#ffc9d9", 300: "#f9a8c4",
              400: "#f4729b", 500: "#ec4899", 600: "#db2777", 700: "#be185d",
              800: "#9d174d", 900: "#831843", 950: "#500724",
            },
            slate: {
              50: "#fcfaf7", 100: "#f5f1eb", 200: "#e7dfd4", 300: "#d1c7bb",
              400: "#a99e91", 500: "#746a60", 600: "#5c534a", 700: "#423a33",
              800: "#2e2924", 900: "#1d1916", 950: "#100d0b",
            },
          },
        },
      },
    };
  </script>
  <title>{{ title }} | DALI Everyday Discount Store</title>
  <style>
    :root {
      color-scheme: light;
      --dali-pink: #db2777;
      --dali-pink-dark: #9d174d;
      --dali-gold: #ffc72c;
      --dali-canvas: #fcfaf7;
      --dali-ink: #1d1916;
    }
    html { scroll-behavior: smooth; }
    body {
      background: var(--dali-canvas);
      color: var(--dali-ink);
      font-family: Inter, "Segoe UI", ui-sans-serif, system-ui, sans-serif;
      -webkit-font-smoothing: antialiased;
    }
    input, select, textarea { color-scheme: light; }
    button, a { transition: color 150ms ease, background-color 150ms ease, border-color 150ms ease, box-shadow 150ms ease; }
    button:not(:disabled), [role="button"] { cursor: pointer; }
    :focus-visible { outline: 3px solid var(--dali-gold); outline-offset: 2px; }
    ::selection { background: var(--dali-gold); color: var(--dali-ink); }
    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto; }
      *, *::before, *::after { transition-duration: 0.01ms !important; }
    }
  </style>
</head>