<aside class="fixed inset-y-0 left-0 z-30 hidden w-56 flex-col overflow-y-auto bg-gradient-to-b from-pink-900 to-pink-950 px-3 py-5 text-white shadow-2xl md:flex">
  <a href="/dashboard" class="flex items-center gap-3 px-2">
    <img src="/dali-pos-logo.svg" alt="" class="h-14 w-12 shrink-0">
    <span class="font-black leading-tight tracking-wide">Dali Everyday Grocery<small class="mt-1 block text-[10px] font-semibold text-pink-100/80">Retail chain · POS</small></span>
  </a>
  {{#if user}}
  <p class="mt-8 px-3 text-[10px] font-black uppercase tracking-[0.2em] text-pink-100/70">Workspace</p>
  <nav aria-label="Main sidebar" class="mt-2 flex flex-col gap-1 text-[13px] font-semibold">
    {{#ifEquals user.role "admin"}}
    <a data-sidebar-link href="/dashboard" title="Dashboard" class="flex items-center gap-3 rounded-xl border-l-4 border-transparent px-3 py-2.5 text-pink-100/90 hover:bg-white/10 hover:text-white"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" class="h-5 w-5 shrink-0"><path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-6v-7h-4v7H4a1 1 0 0 1-1-1V10Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg><span>Dashboard</span></a>
    <a data-sidebar-link href="/pos" title="POS / Cashier" class="flex items-center gap-3 rounded-xl border-l-4 border-transparent px-3 py-2.5 text-pink-100/90 hover:bg-white/10 hover:text-white"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" class="h-5 w-5 shrink-0"><path d="M3 4h2l2.2 10.1a2 2 0 0 0 2 1.6h8.5a2 2 0 0 0 1.9-1.4L22 8H6M10 20h.01M18 20h.01" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg><span>POS / Cashier</span></a>
    <a data-sidebar-link href="/admin/products" title="Products" class="flex items-center gap-3 rounded-xl border-l-4 border-transparent px-3 py-2.5 text-pink-100/90 hover:bg-white/10 hover:text-white"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" class="h-5 w-5 shrink-0"><path d="m12 3 9 5-9 5-9-5 9-5Zm-9 9 9 5 9-5m-18 5 9 5 9-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg><span>Products</span></a>
    <a data-sidebar-link href="/admin/stock-history" title="Inventory" class="flex items-center gap-3 rounded-xl border-l-4 border-transparent px-3 py-2.5 text-pink-100/90 hover:bg-white/10 hover:text-white"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" class="h-5 w-5 shrink-0"><path d="M4 7h16v13H4zM8 7V4h8v3M4 12h16m-11 0v3m6-3v3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg><span class="flex-1">Inventory</span>{{#if lowStockCount}}<span class="rounded-full bg-pink-500 px-2 py-0.5 text-xs font-black text-white">{{lowStockCount}}</span>{{/if}}</a>
    <a data-sidebar-link href="/sales" title="Sales Transactions" class="flex items-center gap-3 rounded-xl border-l-4 border-transparent px-3 py-2.5 text-pink-100/90 hover:bg-white/10 hover:text-white"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" class="h-5 w-5 shrink-0"><path d="M4 19V5m0 14h16M8 15l3-4 3 2 5-7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg><span>Sales Transactions</span></a>
    <a data-sidebar-link href="/dashboard#sales-overview" title="Reports & Analytics" class="flex items-center gap-3 rounded-xl border-l-4 border-transparent px-3 py-2.5 text-pink-100/90 hover:bg-white/10 hover:text-white"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" class="h-5 w-5 shrink-0"><path d="M4 19V5m0 14h16M8 15l3-4 3 2 5-7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg><span>Reports & Analytics</span></a>
    <a data-sidebar-link href="/admin/users" title="Employees" class="flex items-center gap-3 rounded-xl border-l-4 border-transparent px-3 py-2.5 text-pink-100/90 hover:bg-white/10 hover:text-white"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" class="h-5 w-5 shrink-0"><path d="M16 20v-1.5a4.5 4.5 0 0 0-4.5-4.5h-3A4.5 4.5 0 0 0 4 18.5V20m6-9a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm7-7.5a4 4 0 0 1 0 7.7m3 8.8v-1.5a4.5 4.5 0 0 0-3.5-4.4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg><span>Employees</span></a>
    <span aria-disabled="true" title="Settings page is not available yet" class="flex cursor-not-allowed items-center gap-3 rounded-xl px-3 py-2.5 text-pink-100/55"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" class="h-5 w-5 shrink-0"><path d="M12 8.5a3.5 3.5 0 1 0 0 7 3.5 3.5 0 0 0 0-7Zm0-5v2m0 13v2m9-8h-2m-14 0H3m15.4-6.4-1.4 1.4m-10 10-1.4 1.4m12.8 0-1.4-1.4m-10-10L5.6 6.1" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg><span>Settings</span></span>
    <p class="mt-5 px-3 text-[10px] font-black uppercase tracking-[0.2em] text-pink-100/60">More</p>
    <a data-sidebar-link href="/admin/purchase-orders" title="Suppliers & purchasing" class="flex items-center gap-3 rounded-xl border-l-4 border-transparent px-3 py-2.5 text-pink-100/90 hover:bg-white/10 hover:text-white"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" class="h-5 w-5 shrink-0"><path d="M4 7h16v13H4zM8 7V4h8v3M4 12h16m-11 0v3m6-3v3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg><span>Suppliers & purchasing</span></a>
    <a data-sidebar-link href="/admin/activity-logs" title="Activity logs" class="flex items-center gap-3 rounded-xl border-l-4 border-transparent px-3 py-2.5 text-pink-100/90 hover:bg-white/10 hover:text-white"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" class="h-5 w-5 shrink-0"><path d="M4 5h16v14H4zM8 9h8M8 13h8M8 17h4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg><span>Activity logs</span></a>
    <a data-sidebar-link href="/admin/daliaudit" title="DALIAudit" class="flex items-center gap-3 rounded-xl border-l-4 border-transparent px-3 py-2.5 text-pink-100/90 hover:bg-white/10 hover:text-white"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" class="h-5 w-5 shrink-0"><path d="M12 3 3.5 7v5c0 5 3.6 8.3 8.5 9.5 4.9-1.2 8.5-4.5 8.5-9.5V7L12 3Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="m8.5 12 2.2 2.2 4.8-4.8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg><span>DALIAudit</span></a>
    {{/ifEquals}}
    {{#ifEquals user.role "staff"}}
    <a data-sidebar-link href="/dashboard" title="POS / Cashier" class="flex items-center gap-3 rounded-xl border-l-4 border-transparent px-3 py-2.5 text-pink-100/90 hover:bg-white/10 hover:text-white"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" class="h-5 w-5 shrink-0"><path d="M3 4h2l2.2 10.1a2 2 0 0 0 2 1.6h8.5a2 2 0 0 0 1.9-1.4L22 8H6M10 20h.01M18 20h.01" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg><span>POS / Cashier</span></a>
    {{/ifEquals}}
  </nav>
  <div class="mt-auto rounded-2xl border border-white/15 bg-white/5 p-3">
    <p class="truncate px-2 font-bold text-white">{{user.name}}</p>
    <p class="px-2 pt-1 text-xs capitalize text-pink-100/70">{{user.role}}</p>
    <form action="/logout" method="post" class="mt-3">
      <button title="Logout" class="flex w-full items-center gap-3 rounded-xl border border-white/15 px-3 py-2.5 text-left text-sm font-bold text-white hover:bg-white/10"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" class="h-5 w-5"><path d="M10 17l5-5-5-5m5 5H3m9-9h7a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>Logout</button>
    </form>
  </div>
  {{/if}}
</aside>
