# Local app configuration
PORT=3000
NODE_ENV=development
SESSION_SECRET=replace-with-a-long-random-secret

# Local MySQL configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=Dali_pos
DB_USER=root
DB_PASSWORD=

# Local inter-module connection settings for other DALITrack apps
DALIRESOLVE_BASE_URL=http://127.0.0.1:3001
DALICHECK_BASE_URL=http://127.0.0.1:3002
DALIAUDIT_BASE_URL=http://127.0.0.1:3004

# Service-to-service credentials (generate separate random values for each system)
DALI_POS_INTEGRATION_TOKEN=
DALIAUDIT_API_TOKEN=

# Optional admin bootstrap values used by scripts/seed-admin.js
ADMIN_NAME=System Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123456
